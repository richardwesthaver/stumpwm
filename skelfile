:name "stumpwm"
:author ""
:version "1.0.0"
:bind
((emacs-locals
  :dir-locals
  ((nil . ((indent-tabs-mode . nil)))
   (makefile-mode . ((indent-tabs-mode . t)))))
 #+nil (sbcl :env "/usr/local/bin/core")
 (user-swm-dir :env (merge-homedir-pathnames ".stumpwm.d")))
:vc (:hg "https://vc.compiler.company/ext/stumpwm"
     (upstream (:git "https://github.com/stumpwm/stumpwm"))
     (gh (:git "ssh://git@github.com/richardwesthaver/stumpwm")))
:rules
((default (build))
 (build () #$sbcl --load ./make-image.lisp$#)
 (:install ()
  (with-sudo 
   "install -m 755 stumpwm /usr/local/bin/"))
 (modules () (:install () #$cp -rf contrib/ $USER_SWM_DIR/contrib$#))
 (clean ()
  #$rm -f *.fasl *.fas *.lib *.*fsl
  rm -f *.log *.fns *.fn *.aux *.cp *.ky *.log *.toc *.pg *.tp *.vr *.vrs
  rm -f stumpwm$#))

